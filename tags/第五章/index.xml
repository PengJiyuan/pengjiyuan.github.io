    <item>
      <title>第五章：异常值</title>
      <link>https://pengjiyuan.github.io/novel/%E5%BC%82%E5%B8%B8%E5%80%BC/</link>
      <pubDate>Fri, 10 Apr 2026 00:00:00 +0000</pubDate>
